<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{YYYY-MM-dd HH:mm:ss}  [%t] %-5level %logger::%M::%L - %msg%n" />
		</Console>

		<File name="LoggerFile" fileName="logs/automation.log"
			append="false">

			<PatternLayout
				pattern="%d{YYYY-MM-dd HH:mm:ss}  [%t] %-5level %logger::%M::%L - %msg%n" />
		</File>

	</Appenders>
	<Loggers>
		<Root level="info">
			<AppenderRef ref="Console" />
			<AppenderRef ref="LoggerFile" />
		</Root>

	</Loggers>


</Configuration>